                "type": "object",
                "description": "One image and what tapping it does.",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Its title."
                  },
                  "action": {
                    "type": "string",
                    "description": "What tapping it does."
                  },
                  "iconUrl": {
                    "type": "string",
                    "description": "Its picture."
                  }
                }
              }
            },
            "description": {
              "type": "string",
              "description": "The description, with its formatting."
            }
          }
        }
      }
