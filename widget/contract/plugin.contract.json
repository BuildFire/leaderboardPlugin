{
  "description": "A leaderboard ranking your app's users by their points for the day, the week, the month and overall, with an introduction shown behind it.",
  "events": [
    {
      "name": "scoreUpdated",
      "displayName": "Score Updated",
      "description": "Someone's score changed, because points were added or today's score was edited.",
      "data": {
        "user": {
          "type": "object",
          "displayName": "User",
          "description": "Whose score changed.",
          "properties": {
            "userId": {
              "type": "string",
              "displayName": "User ID",
              "description": "Their id."
            },
            "displayName": {
              "type": "string",
              "displayName": "Name",
              "description": "Their name."
            },
            "email": {
              "type": "string",
              "displayName": "Email",
              "description": "Their email."
            }
          }
        },
        "change": {
          "type": "string",
          "displayName": "Change",
          "description": "How the score changed, Added or Edited."
        },
        "points": {
          "type": "number",
          "displayName": "Points",
          "description": "The points added, or the new score for today."
        },
        "dailyScore": {
          "type": "number",
          "displayName": "Today's Score",
          "description": "Their score for today."
        },
        "weeklyScore": {
          "type": "number",
          "displayName": "This Week's Score",
          "description": "Their score for this week."
        },
        "monthlyScore": {
          "type": "number",
          "displayName": "This Month's Score",
          "description": "Their score for this month."
        },
        "overallScore": {
          "type": "number",
          "displayName": "Overall Score",
          "description": "Their overall score."
        }
      }
    }
  ],
  "operations": [
    {
      "name": "listScores",
      "displayName": "List scores",
      "type": "function",
      "crudMode": "read",
      "flags": [
        "immutable",
        "safe",
        "unthrottable"
      ],
      "usage": "basic",
      "availableFor": [
        "API",
        "form"
      ],
      "context": {
        "functionName": "listScores",
        "hosts": [
          "widgetBackground",
          "controlBackground",
          "headlessSdk"
        ]
      },
      "description": "Shows the leaderboard for today, this week, this month or overall, best score first.",
      "parameters": {
        "period": {
          "type": "select",
          "displayName": "Board",
          "required": false,
          "description": "Which board to show. Leave it out to show the overall board.",
          "enums": [
            {
              "label": "Overall",
              "value": "overall"
            },
            {
              "label": "Month",
              "value": "monthly"
            },
            {
              "label": "Week",
              "value": "weekly"
            },
            {
              "label": "Day",
              "value": "daily"
            }
          ],
          "allowEnumCustomOption": false,
          "sampleValue": "overall"
        },
        "userId": {
          "type": "user",
          "displayName": "User",
          "required": false,
          "description": "Only show this person's place, by their id or email. Leave it out to show everyone.",
          "sampleValue": "[user id]"
        },
        "callback": {
          "type": "function",
          "required": true,
          "description": "Runs when the board is ready.",
          "parameters": {
            "error": {
              "type": "object|string",
              "description": "Why it didn't work, such as no user having that email."
            },
            "result": {
              "type": "object",
              "description": "The board that was found.",
              "properties": {
                "scores": {
                  "type": "array",
                  "description": "Everyone on the board, best score first.",
                  "items": {
                    "type": "object",
                    "description": "One person's place.",
                    "properties": {
                      "rank": {
                        "type": "number",
                        "description": "Their place on the board, starting at 1."
                      },
                      "userId": {
                        "type": "string",
                        "description": "Their id."
                      },
                      "displayName": {
                        "type": "string",
                        "description": "Their name."
                      },
                      "score": {
                        "type": "number",
                        "description": "Their points."
                      },
                      "imageUrl": {
                        "type": "string",
                        "description": "Their profile picture."
                      },
                      "createdOn": {
                        "type": "datetime",
                        "description": "When their score last changed."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "updateUserScore",
      "displayName": "Update user score",
      "type": "function",
      "crudMode": "update",
      "flags": [
        "mutable",
        "dangerous",
        "throttable"
      ],
      "usage": "basic",
      "availableFor": [
        "API",
        "form"
      ],
      "context": {
        "functionName": "updateUserScore",
        "hosts": [
          "widgetBackground",
          "controlBackground",
          "headlessSdk"
        ]
      },
      "description": "Adds points to a person's score, or sets their score for today, on behalf of the app.",
      "parameters": {
        "userId": {
          "type": "user",
          "displayName": "User",
          "required": true,
          "description": "The person whose score changes, by their id or email.",
          "sampleValue": "[user id]"
        },
        "score": {
          "type": "number",
          "displayName": "Score",
          "required": true,
          "description": "The points to add, or the new score for today when editing.",
          "sampleValue": 10
        },
        "logType": {
          "type": "select",
          "displayName": "Change",
          "required": false,
          "description": "Whether the points are added to the score or become today's score. Leave it out to add them.",
          "enums": [
            {
              "label": "Add Score",
              "value": "add"
            },
            {
              "label": "Edit Score",
              "value": "edit"
            }
          ],
          "allowEnumCustomOption": false,
          "sampleValue": "add"
        },
        "callback": {
          "type": "function",
          "required": true,
          "description": "Runs when the score is saved.",
          "parameters": {
            "error": {
              "type": "object|string",
              "description": "Why it didn't work, such as no user having that id or email."
            },
            "result": {
              "type": "object",
              "description": "The person's new scores.",
              "properties": {
                "userId": {
                  "type": "string",
                  "description": "The person's id."
                },
                "displayName": {
                  "type": "string",
                  "description": "The person's name, as the leaderboard shows it."
                },
                "dailyScore": {
                  "type": "number",
                  "description": "Their score for today."
                },
                "weeklyScore": {
                  "type": "number",
                  "description": "Their score for this week."
                },
                "monthlyScore": {
                  "type": "number",
                  "description": "Their score for this month."
                },
                "overallScore": {
                  "type": "number",
                  "description": "Their overall score."
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "updateUserScoresAdvanced",
      "displayName": "Update users' scores",
      "type": "function",
      "crudMode": "update",
      "flags": [
        "mutable",
        "dangerous",
        "throttable"
      ],
      "usage": "advanced",
      "availableFor": [
        "API"
      ],
      "context": {
        "functionName": "updateUserScoresAdvanced",
        "hosts": [
          "widgetBackground",
          "controlBackground",
          "headlessSdk"
        ]
      },
      "description": "Changes the scores of several people at once.",
      "parameters": {
        "scores": {
          "type": "list",
          "displayName": "Scores",
          "required": true,
          "minValue": 1,
          "maxValue": 50,
          "description": "The score changes to make, up to 50 at a time, each for a different person.",
          "items": {
            "userId": {
              "type": "user",
              "displayName": "User",
              "required": true,
              "description": "The person whose score changes, by their id or email.",
              "sampleValue": "[user id]"
            },
            "score": {
              "type": "number",
              "displayName": "Score",
              "required": true,
              "description": "The points to add, or the new score for today when editing.",
              "sampleValue": 10
            },
            "logType": {
              "type": "select",
              "displayName": "Change",
              "required": false,
              "description": "Whether the points are added to the score or become today's score. Leave it out to add them.",
              "enums": [
                {
                  "label": "Add Score",
                  "value": "add"
                },
                {
                  "label": "Edit Score",
                  "value": "edit"
                }
              ],
              "allowEnumCustomOption": false,
              "sampleValue": "add"
            }
          },
          "sampleValue": [
            {
              "userId": "[user id]",
              "score": 10,
              "logType": "add"
            },
            {
              "userId": "[user id]",
              "score": 25,
              "logType": "edit"
            }
          ]
        },
        "callback": {
          "type": "function",
          "required": true,
          "description": "Runs when every score is done.",
          "parameters": {
            "error": {
              "type": "object|string",
              "description": "Why nothing was changed, such as a score missing its person."
            },
            "result": {
              "type": "object",
              "description": "How each score change went.",
              "properties": {
                "scores": {
                  "type": "array",
                  "description": "One result per score change, in the order they were given.",
                  "items": {
                    "type": "object",
                    "description": "How one score change went.",
                    "properties": {
                      "index": {
                        "type": "number",
                        "description": "Which score change this is, counting from 0."
                      },
                      "id": {
                        "type": "string",
                        "description": "The person's id, if their score changed."
                      },
                      "error": {
                        "type": "string",
                        "description": "Why it didn't change, if it didn't."
                      }
                    }
                  }
                },
                "succeeded": {
                  "type": "number",
                  "description": "How many scores changed."
                },
                "failed": {
                  "type": "number",
                  "description": "How many scores didn't change."
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "resetLeaderboard",
