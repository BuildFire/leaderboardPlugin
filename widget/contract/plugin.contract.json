      },
      "description": "Permanently clears every score on today's, this week's, this month's and the overall board.",
      "parameters": {
        "callback": {
          "type": "function",
          "required": true,
          "description": "Runs when the leaderboard is cleared.",
          "parameters": {
            "error": {
              "type": "object|string",
              "description": "Why it didn't work, if it didn't."
            },
            "result": {
              "type": "object",
              "description": "What was cleared.",
              "properties": {
                "cleared": {
                  "type": "array",
                  "description": "The boards that were cleared.",
